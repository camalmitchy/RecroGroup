# Recro Group - Environment Variables Example
# ----------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in your values.
# Never commit real secrets. .env* is gitignored.
#
# Required for local development and production.

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Examples:
#   Local:   postgresql://postgres:postgres@localhost:5432/recro?schema=public
#   Neon:    postgresql://user:pass@ep-xxx.region.aws.neon.tech/recro?sslmode=require
#   Render/Supabase/etc: use the provider's full connection string.
# On Vercel this MUST be a hosted database (not localhost) with sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recro?schema=public"

# ----------------------------------------------------------------------------
# BETTER AUTH (Authentication)
# ----------------------------------------------------------------------------
# Secret used for signing sessions, tokens, and encryption.
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret-min-32-chars"

# Public base URL of your app (used for generating links in emails, redirects, etc.).
# Local development:  http://localhost:3000
# Production:  https://recrogroup.org
# Do not leave this as localhost on Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional). Add each deployed origin in Google Cloud as an
# authorized redirect URI, for example:
#   http://localhost:3000/api/auth/callback/google
#   https://recrogroup.org/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Set to "false" to hide the Google button even when credentials exist.
# The button is shown automatically when GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# are set (including on Vercel; those secrets do not need a NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=""

# Staff emails to restore on production. Local role grants do not copy to Vercel
# because it uses a different database. Comma-separated. If unset, Recro's
# previously granted admin/receptionist emails are used.
BOOTSTRAP_ADMIN_EMAILS=""
BOOTSTRAP_RECEPTIONIST_EMAILS=""

# ----------------------------------------------------------------------------
# DEVELOPMENT HELPERS (optional)
# ----------------------------------------------------------------------------
# DEV_PORTAL_ROLE
# When running in development (NODE_ENV=development) AND BETTER_AUTH_SECRET
# is not set, the portal will automatically log you in as this role.
# Useful for UI development without a real database/auth setup.
#
# Allowed values: admin | receptionist | customer
# Default (if unset): admin
DEV_PORTAL_ROLE="admin"

# ----------------------------------------------------------------------------
# APP URL
# ----------------------------------------------------------------------------
# Public base URL used to build payment callback and return URLs.
# Falls back to BETTER_AUTH_URL, then http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# M-PESA (Safaricom Daraja)
# ----------------------------------------------------------------------------
# sandbox | production
MPESA_ENV="sandbox"

# From your Daraja app (https://developer.safaricom.co.ke).
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""

# MPESA_SHORTCODE is the Head Office code the passkey was issued for.
# Booking STK is Buy Goods (CustomerBuyGoodsOnline) to MPESA_TILL_NUMBER.
# BusinessShortCode stays the Head Office; PartyB is the till.
# If the till itself is the Lipa Na M-Pesa Online merchant, set BOTH to the till.
# Sandbox shortcode 174379 is Pay Bill: leave MPESA_TILL_NUMBER empty there.
MPESA_SHORTCODE=""
MPESA_TILL_NUMBER="747736"

# Lipa na M-Pesa Online passkey (issued for MPESA_SHORTCODE).
MPESA_PASSKEY=""

# Leave unset to send booking STK to the till. Set "false" only to force Pay Bill
# to MPESA_SHORTCODE (sandbox shortcode 174379).
MPESA_STK_USE_TILL=""

# Optional override for the STK callback. Leave blank and it is derived from
# NEXT_PUBLIC_APP_URL. Set it when the public hostname differs from the app URL,
# e.g. when tunnelling locally. Must be publicly reachable HTTPS either way.
MPESA_CALLBACK_URL=""

# Optional C2B URLs, for customers who pay the till directly outside the app.
# Register them once via the Daraja C2B register endpoint.
MPESA_CONFIRMATION_URL="https://recrogroup.org/api/payments/webhooks/mpesa/c2b"
MPESA_VALIDATION_URL="https://recrogroup.org/api/payments/webhooks/mpesa/validation"

# Daraja callbacks carry NO signature, so production and Vercel enforce the
# Safaricom IP allowlist unless this is explicitly set to "false".
# Leave unset (or "true") in production. Set "false" only for local tunnels.
MPESA_ENFORCE_IP_ALLOWLIST=""
MPESA_ALLOWED_IPS=""

# How long an STK push is considered live before being marked failed.
MPESA_STK_TIMEOUT_SECONDS="120"

# ----------------------------------------------------------------------------
# PAYSTACK (card payments — coming soon)
# ----------------------------------------------------------------------------
# Card checkout is hidden in the public UI until this is enabled.
# Leave these blank for launch. Use test keys (sk_test_/pk_test_) when ready.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# In the Paystack dashboard (Settings > API Keys & Webhooks) set:
#   Callback URL: https://recrogroup.org/api/payments/return
#   Webhook URL:  https://recrogroup.org/api/payments/webhooks/paystack
# The callback is where the customer's browser lands; the webhook is the
# server-to-server confirmation that actually settles the payment.
# This variable is an optional override — the app derives the return URL from
# NEXT_PUBLIC_APP_URL, so leave it blank unless the two must differ.
PAYSTACK_CALLBACK_URL=""

# ----------------------------------------------------------------------------
# FILE UPLOADS (Vercel Blob)
# ----------------------------------------------------------------------------
# Stores bank transfer slips and grief-camp flyers. Create a Blob store in
# Vercel Storage and link it to this project. On Vercel the SDK can use OIDC
# without copying this token; set it locally after `vercel env pull`.
# Without it, slip uploads are rejected with a clear message rather than
# silently discarded.
BLOB_READ_WRITE_TOKEN=""

# ----------------------------------------------------------------------------
# PAYMENTS (general)
# ----------------------------------------------------------------------------
# Percentage of a service price taken as the booking commitment fee.
BOOKING_DEPOSIT_PERCENT="50"

# Bearer token guarding POST /api/payments/reconcile, which marks abandoned
# STK pushes as failed. Point a scheduler at it every 10-15 minutes.
# Leave unset and the endpoint stays closed.
PAYMENTS_CRON_SECRET=""

# ----------------------------------------------------------------------------
# MAIL
# ----------------------------------------------------------------------------
# "resend" sends real email. "console" logs messages instead of sending.
# If MAIL_DRIVER is unset, Resend is used whenever RESEND_API_KEY is present.
MAIL_DRIVER=""
RESEND_API_KEY=""
MAIL_FROM="Recro Group <no-reply@recrogroup.org>"
MAIL_REPLY_TO=""
# When set, staff receive an alert on each paid booking, inquiry and payment.
# Comma-separated. If unset, Recro's admin mailbox is used (minanicalm@gmail.com).
MAIL_STAFF_ADDRESS=""

# ----------------------------------------------------------------------------
# GOOGLE SHEETS (form copies)
# ----------------------------------------------------------------------------
# Grief camp, corporate speaking, team building, and consortium submissions
# stay in the Recro database and are also appended to your Google Sheet.
# Open the sheet, Extensions > Apps Script, paste scripts/google-sheets-webhook.gs,
# Deploy > New deployment > Web app (Execute as: Me, Who has access: Anyone).
# Put the web app URL here. Optional secret goes in Script Properties as
# WEBHOOK_SECRET and in this env var.
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_WEBHOOK_SECRET=""

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# - NODE_ENV is automatically set by Next.js (development / production / test).
# - Run `npm run db:seed` after migrating to load services and camp price tiers.
#   Booking and grief camp amounts are resolved from the database server-side;
#   the client never supplies a price.
# - For production deployments (Vercel, etc.), set the same variables in the
#   platform's environment variable dashboard.
