// Recro Group — Neon PostgreSQL + Better Auth
// Core auth tables map to Better Auth (`user`, `session`, `account`, `verification`).
// Admin plugin adds: role, banned, banReason, banExpires on user; impersonatedBy on session.
// App roles (string): admin | customer | receptionist

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth (core) ──────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Admin plugin
  role       String?   @default("customer")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Recro profile (additionalFields in auth.ts)
  phone       String?
  accountType AccountType @default(CUSTOMER)
  commsEmail  Boolean     @default(true)
  commsSms    Boolean     @default(false)

  sessions          Session[]
  accounts          Account[]
  bookings          Booking[]
  appointments      Appointment[]
  payments          Payment[]
  verifiedPayments  Payment[]          @relation("PaymentVerifiedBy")
  griefApplications GriefApplication[]
  savedResources    SavedResource[]
  donations         Donation[]

  @@unique([email])
  @@index([role])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── App enums ───────────────────────────────────────────────────────────────

enum AccountType {
  CUSTOMER
  GUARDIAN
  CORPORATE
}

// ─── People (portal › people) ────────────────────────────────────────────────

model Therapist {
  id          String   @id @default(cuid())
  fullName    String
  title       String?
  bio         String?  @db.Text
  specialties String[]
  photoUrl    String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings     Booking[]
  appointments Appointment[]

  @@map("therapists")
}

// ─── Content (portal › content) ──────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  priceKes    Int?
  durationMin Int?
  category    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings     Booking[]
  appointments Appointment[]

  @@map("services")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  body        String?   @db.Text
  coverUrl    String?
  author      String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model MediaItem {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  mediaType    MediaType @default(VIDEO)
  url          String
  thumbnailUrl String?
  isPublished  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("media_items")
}

enum MediaType {
  VIDEO
  ARTICLE
  PODCAST
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String?
  quote       String   @db.Text
  rating      Int?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

// ─── Operations (portal › bookings, payments) ────────────────────────────────

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  BANK
  CARD
}

enum PaymentProvider {
  MPESA_DARAJA
  PAYSTACK
  MANUAL
}

enum PaymentPurpose {
  BOOKING_DEPOSIT
  BOOKING_BALANCE
  BOOKING_FULL
  GRIEF_CAMP_FEE
  DONATION
  MERCHANDISE
  OTHER
}

enum Currency {
  KES
  USD
}

enum SessionMode {
  IN_PERSON
  ONLINE
  PHONE
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  therapistId   String?
  therapist     Therapist?    @relation(fields: [therapistId], references: [id], onDelete: SetNull)
  clientName    String
  clientEmail   String
  clientPhone   String?
  preferredDate DateTime?     @db.Date
  preferredTime String?
  sessionMode   SessionMode?
  notes         String?       @db.Text
  status        BookingStatus @default(REQUESTED)
  paymentStatus PaymentStatus @default(PENDING)
  amountKes     Int?
  depositKes    Int?
  amountPaidKes Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointments Appointment[]
  payments     Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(cuid())
  bookingId   String?
  booking     Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  therapistId String?
  therapist   Therapist?        @relation(fields: [therapistId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  durationMin Int               @default(60)
  status      AppointmentStatus @default(CONFIRMED)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([scheduledAt])
  @@map("appointments")
}

model Payment {
  id       String @id @default(cuid())
  reference String @unique

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  griefApplicationId String?
  griefApplication   GriefApplication? @relation(fields: [griefApplicationId], references: [id], onDelete: SetNull)
  donationId         String?
  donation           Donation?         @relation(fields: [donationId], references: [id], onDelete: SetNull)

  method   PaymentMethod
  provider PaymentProvider
  purpose  PaymentPurpose  @default(OTHER)
  currency Currency        @default(KES)

  amountKes Int
  settledAmountKes Int?

  status PaymentStatus @default(PENDING)
  notes  String?       @db.Text

  providerRef String?
  providerMeta Json?
  failureReason String?

  mpesaCheckoutId String?
  mpesaReceipt    String? @unique
  phone           String?
  proofUrl        String?

  idempotencyKey String? @unique

  verifiedById String?
  verifiedBy   User?     @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  paidAt       DateTime?
  expiresAt    DateTime?

  events PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider, providerRef])
  @@index([bookingId])
  @@index([createdAt])
  @@map("payments")
}

model PaymentEvent {
  id        String  @id @default(cuid())
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  eventType String
  dedupeKey String @unique

  payload   Json
  processed Boolean @default(false)
  error     String? @db.Text

  createdAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([processed])
  @@index([createdAt])
  @@map("payment_events")
}

model Donation {
  id          String  @id @default(cuid())
  reference   String  @unique
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  donorName   String
  donorEmail  String
  donorPhone  String?
  isAnonymous Boolean @default(false)
  message     String? @db.Text

  amountKes     Int
  currency      Currency      @default(KES)
  paymentStatus PaymentStatus @default(PENDING)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentStatus])
  @@index([createdAt])
  @@map("donations")
}

// ─── Programs (portal › programs) ────────────────────────────────────────────

enum GriefApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum CampAttendeeType {
  CAMPER
  PARENT
}

model CampSession {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  startsOn    DateTime @db.Date
  endsOn      DateTime @db.Date
  location    String?
  description String?  @db.Text
  isActive    Boolean  @default(false)
  capacity    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceTiers   CampPriceTier[]
  applications GriefApplication[]

  @@index([isActive])
  @@map("camp_sessions")
}

model CampPriceTier {
  id            String           @id @default(cuid())
  campSessionId String
  campSession   CampSession      @relation(fields: [campSessionId], references: [id], onDelete: Cascade)
  attendeeType  CampAttendeeType
  label         String
  amountKes     Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([campSessionId, attendeeType, effectiveFrom])
  @@map("camp_price_tiers")
}

model GriefApplication {
  id            String       @id @default(cuid())
  reference     String       @unique
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  campSessionId String?
  campSession   CampSession? @relation(fields: [campSessionId], references: [id], onDelete: SetNull)

  parentName  String
  parentEmail String
  parentPhone String?
  childName   String
  childAge    Int?
  lossContext String? @db.Text
  tier        String?

  parentAttending Boolean @default(false)

  formData Json?

  amountKes     Int?
  paymentStatus PaymentStatus @default(PENDING)

  status GriefApplicationStatus @default(PENDING)
  notes  String?                @db.Text

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([campSessionId])
  @@index([createdAt])
  @@map("grief_applications")
}

// ─── Engagement (portal › inquiries) ─────────────────────────────────────────

enum InquiryType {
  CONTACT
  CORPORATE
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType   @default(CONTACT)
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([type])
  @@index([status])
  @@map("inquiries")
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id        String           @id @default(cuid())
  email     String           @unique
  status    NewsletterStatus @default(SUBSCRIBED)
  createdAt DateTime         @default(now())

  @@map("newsletter_subscribers")
}

// ─── Customer portal ─────────────────────────────────────────────────────────

enum SavedResourceType {
  BLOG
  MEDIA
}

model SavedResource {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType SavedResourceType
  resourceId   String?
  title        String?
  url          String?
  createdAt    DateTime          @default(now())

  @@unique([userId, resourceType, resourceId])
  @@map("saved_resources")
}

// ─── System (portal › settings) ──────────────────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
